# Copy this file to .env for LOCAL testing only.
# In GitHub Actions, these are set as repo Secrets instead — never commit a real .env file.

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

YT_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
YT_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxx
YT_REFRESH_TOKEN=xxxxxxxxxxxxxxxxxxxx

# Optional: read-only key for trending-tag enrichment
YT_API_KEY=

# Strongly recommended: without this, every scene falls back to the gradient
# background instead of real footage — this channel leans on real clips more
# than the others since there's no news-style fallback content to lean on.
PEXELS_API_KEY=

NEWS_REGION=US
YT_CATEGORY_ID=27                 # 27 = Education
YT_PRIVACY_STATUS=scheduled        # public | unlisted | private | scheduled
YT_PUBLISH_DELAY_HOURS=3
